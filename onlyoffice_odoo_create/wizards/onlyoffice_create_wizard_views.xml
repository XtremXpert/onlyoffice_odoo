<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="onlyoffice_create_wizard_form" model="ir.ui.view">
    <field name="name">onlyoffice.create.wizard.form</field>
    <field name="model">onlyoffice.create.wizard</field>
    <field name="arch" type="xml">
      <form string="Nouveau document ONLYOFFICE">
        <group>
          <field name="doc_format" widget="radio" />
          <field name="name" placeholder="Titre du document" />
        </group>
        <footer>
          <button name="action_create_open" type="object" string="Créer et ouvrir" class="btn-primary" />
          <button string="Annuler" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_onlyoffice_create_wizard" model="ir.actions.act_window">
    <field name="name">Nouveau document</field>
    <field name="res_model">onlyoffice.create.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
